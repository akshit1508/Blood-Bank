# Blood Bank Platform - Environment Configuration

# Backend API Environment
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/blood_bank

# Authentication & Session Security (REQUIRED)
# In production, must be a cryptographically secure random string of at least 32 characters.
# For existing local development sessions, use: blood-bank-admin-secure-auth-secret-key-2026
AUTH_SESSION_SECRET=blood-bank-admin-secure-auth-secret-key-2026
JWT_SECRET=blood-bank-admin-secure-auth-secret-key-2026
JWT_EXPIRES_IN=7d

# Initial Administrator Bootstrap Credentials (REQUIRED for initial database seed)
# Used only when the database contains zero administrator records.
INITIAL_ADMIN_EMAIL=admin@bloodbank.org
INITIAL_ADMIN_PASSWORD=change-to-a-strong-bootstrap-password-in-production

# Frontend Web Environment
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME="Blood Bank Management Platform"
